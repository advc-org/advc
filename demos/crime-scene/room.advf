// --- officer ----------------------------------------------------------------
func useOfficer
    mouse::active false
    switch crime::verb
        call goOfficer
        call Look_Officer
        call Pick_Officer
        call Talk_Officer
        call cantPull
    end
    call actionDone
func Look_Officer
    call goOfficer
    wait talk LookOfficer
func Pick_Officer
    call goOfficer
    wait talk PickOfficer
func Talk_Officer
    call goOfficer
    wait talk TalkOfficer
    wait talk OffGreet
    call officerDialog

// --- ambience ---------------------------------------------------------------
anim rain_anim
    duration 1
        image 0 0 0 rain_0
    duration 1
        image 0 0 0 rain_1
    duration 1
        image 0 0 0 rain_2

anim neon_flicker
    duration 2
        image 0 0 0 neon_off
    duration 1
        noimage 0
    duration 1
        image 0 0 0 neon_off
    duration 3
        noimage 0

func musicLoop
    wait sound music_noir 0.35
    start musicLoop

func rainLoop
    wait sound amb_rain 0.45
    start rainLoop

func rainFall
    select rain
    wait play rain_anim 100 0.3s
    start rainFall

func neonLoop
    wait random
        nothing 5s
        nothing 8s
        nothing 13s
    end
    sound amb_neon 0.25
    select neon
    wait play neon_flicker 1 0.7s
    start neonLoop

func sirenLoop
    wait random
        nothing 25s
        nothing 40s
    end
    wait random
        sound amb_siren 0.25
        sound amb_thunder 0.5
    end
    start sirenLoop
