// Detective voice lines (macOS TTS, lipsynced at build time). Each voice
// selects the detective first so the lipsync drives his mouth + portrait.
// Generated by tools/voices_advf.py from tools/script.py.

voice Intro1
    en v_Intro1 "Bay City. One forty in the morning, and the rain still hasn't figured out when to quit."
    before
        select detective
voice Intro2
    en v_Intro2 "Arthur Kessler. Reporter. Somebody wanted him quiet, and somebody got their wish."
    before
        select detective
voice Intro3
    en v_Intro3 "Let's see what this room wants to tell me."
    before
        select detective
voice LookBoard1
    en v_LookBoard1 "Kessler's wall of madness. Photos, clippings, red string. Everything points to one word."
    before
        select detective
voice LookBoard2
    en v_LookBoard2 "Lethe. And pinned around it, Halcyon Pharmaceuticals. This was no hobby."
    before
        select detective
voice PickBoard
    en v_PickBoard "It's nailed to the wall, and it's evidence. Two good reasons to leave it."
    before
        select detective
voice PullBoard
    en v_PullBoard "If I pull this down, the whole conspiracy comes down with it. Not tonight."
    before
        select detective
voice TalkBoard
    en v_TalkBoard "Nobody on that board is talking. Yet."
    before
        select detective
voice LookPapers
    en v_LookPapers "Papers on the desk. Halcyon letterhead."
    before
        select detective
voice PickPapers
    en v_PickPapers "Shipping manifests. Crates to Pier thirty nine, every Tuesday, signed by a Doctor V. I'll take these."
    before
        select detective
voice LookDrawers
    en v_LookDrawers "Steel drawers. Every one has a keyhole, and none of them has a key."
    before
        select detective
voice PullLocked
    en v_PullLocked "Locked. Whoever has the key isn't in this room anymore."
    before
        select detective
voice PullStuck
    en v_PullStuck "Stuck tight. Somebody jammed it shut. Or it's as stubborn as I am."
    before
        select detective
voice PickDrawers
    en v_PickDrawers "I'd need a crowbar and a warrant. I've got neither."
    before
        select detective
voice LookCabinet
    en v_LookCabinet "A filing cabinet. Kessler's whole career, alphabetized and locked away."
    before
        select detective
voice PullCabinet
    en v_PullCabinet "Locked. All four drawers. A dead man's secrets, still well guarded."
    before
        select detective
voice LookTrash1
    en v_LookTrash1 "Let's see what Kessler threw away."
    before
        select detective
voice LookTrash2
    en v_LookTrash2 "A business card, crumpled up. Doctor Helena Voss, Halcyon Research. On the back, in Kessler's hand: Lethe."
    before
        select detective
voice LookTrashEmpty
    en v_LookTrashEmpty "Coffee grounds, cigarette butts and bad first drafts. Nothing else worth keeping."
    before
        select detective
voice PickTrash
    en v_PickTrash "I'm not hauling a garbage can out of a crime scene. The captain already thinks I'm a bum."
    before
        select detective
voice LookNeedle
    en v_LookNeedle "Something shiny on the floor, by the trash can."
    before
        select detective
voice PickNeedle
    en v_PickNeedle "A syringe. Teal cap, Halcyon colors. Kessler didn't use. Somebody brought this to him."
    before
        select detective
voice LookWindow
    en v_LookWindow "Halcyon Tower, right across the street. Their neon never sleeps. Neither do I, lately."
    before
        select detective
voice PullWindow
    en v_PullWindow "The blinds are already busted. Somebody wanted a look outside, or wanted nobody looking in."
    before
        select detective
voice LookLamp
    en v_LookLamp "The lamp's still warm. Kessler worked late. His last night, he worked very late."
    before
        select detective
voice LookTypewriter
    en v_LookTypewriter "A half typed page. They are testing it on people nobody will miss. Then nothing."
    before
        select detective
voice LookShelf
    en v_LookShelf "Chemistry, corporate law, and a history of the docks. Light reading for a dead man."
    before
        select detective
voice LookChair
    en v_LookChair "Chair's knocked over. Kessler didn't go quietly."
    before
        select detective
voice LookChalk
    en v_LookChalk "That's where they found him. The tape keeps me out, and the chalk keeps him in."
    before
        select detective
voice LookDoor
    en v_LookDoor "The hallway. Smells like boiled cabbage and bad decisions."
    before
        select detective
voice PullDoor
    en v_PullDoor "I'm not leaving yet. Kessler still owes me some answers."
    before
        select detective
voice LookOfficer
    en v_LookOfficer "Officer Dooley. Good cop. Bad coffee."
    before
        select detective
voice PickOfficer
    en v_PickOfficer "Dooley's two hundred pounds of Irish stubborn. He stays where he is."
    before
        select detective
voice LookSelf
    en v_LookSelf "Frank Malone. Twenty years on the force, and I still buy my own coffee."
    before
        select detective
voice TalkSelf
    en v_TalkSelf "Talking to myself again. At least somebody listens."
    before
        select detective
voice LookMagnifier
    en v_LookMagnifier "My magnifying glass. Old school, like me."
    before
        select detective
voice LookKit
    en v_LookKit "Fingerprint kit. This place was wiped cleaner than a senator's record."
    before
        select detective
voice LookNotepad
    en v_LookNotepad "My notepad. Half of it is clues. The other half is lunch orders."
    before
        select detective
voice LookPapersInv
    en v_LookPapersInv "Halcyon manifests. Crates to Pier thirty nine, signed Doctor V."
    before
        select detective
voice LookCardInv
    en v_LookCardInv "Doctor Helena Voss, Halcyon Research. Doctor V, I presume."
    before
        select detective
voice LookNeedleInv
    en v_LookNeedleInv "The syringe. Teal cap, Halcyon colors. Kessler never shot anything but his mouth."
    before
        select detective
voice HaveIt
    en v_HaveIt "I've already got it."
    before
        select detective
voice CantPick1
    en v_CantPick1 "I can't pick that up."
    before
        select detective
voice CantPick2
    en v_CantPick2 "That's not going in my pocket."
    before
        select detective
voice CantPull
    en v_CantPull "Pulling that won't get me anywhere."
    before
        select detective
voice CantTalk1
    en v_CantTalk1 "I've got nothing to say to that."
    before
        select detective
voice CantTalk2
    en v_CantTalk2 "Talking to furniture. That's a new low, Malone."
    before
        select detective
voice TalkOfficer
    en v_TalkOfficer "Got a minute, Dooley?"
    before
        select detective
voice AskWhat
    en v_AskWhat "So what happened here?"
    before
        select detective
voice What3
    en v_What3 "Nothing's open and shut in this town. Except my wallet."
    before
        select detective
voice AskWho
    en v_AskWho "Tell me about Kessler."
    before
        select detective
voice Who3
    en v_Who3 "And nobody followed up. Figures."
    before
        select detective
voice AskWitness
    en v_AskWitness "Anybody see anything?"
    before
        select detective
voice Witness2
    en v_Witness2 "A nice car in this neighborhood sticks out like an honest alderman."
    before
        select detective
voice AskLocked
    en v_AskLocked "Why is everything locked up?"
    before
        select detective
voice AskBye
    en v_AskBye "Thanks, Dooley. Go get yourself some coffee."
    before
        select detective
voice Final1
    en v_Final1 "Shipping papers, a syringe, and a business card from a doctor whose name starts with V."
    before
        select detective
voice Final2
    en v_Final2 "You were onto something big, Kessler. Big enough to kill for."
    before
        select detective
voice Final3
    en v_Final3 "Halcyon Pharmaceuticals. I think it's time I paid you a visit."
    before
        select detective
