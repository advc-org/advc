// Generated by tools/art.py from the AI paintings: do not edit by hand.
// Sprite canvases and torch flames measured on the paintings (PLAN.md 5.2); the
// page files call these geo_<scene> funcs after showing their picture.

anim flicker_throne0
    duration 1
        image 0 0 0 throne_t0_0
    duration 1
        image 0 0 0 throne_t0_1
    duration 1
        image 0 0 0 throne_t0_0
    duration 1
        image 0 0 0 throne_t0_2
anim flicker_throne1
    duration 1
        image 0 0 0 throne_t1_0
    duration 1
        image 0 0 0 throne_t1_1
    duration 1
        image 0 0 0 throne_t1_0
    duration 1
        image 0 0 0 throne_t1_2
// #1, #4: the throne room (torch flicker)
func geo_throne
    select flame1
    pos 1259 220
    play flicker_throne0 99999 0.50s
    select flame2
    pos 1816 173
    play flicker_throne1 99999 0.63s

