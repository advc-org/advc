// The dungeon map: rooms appear once visited, a ring marks the current one.
// Positions measured on the painted map (tools/art.py step_map).
ui minimap modal=false
    if map::lair == 1 pos=151,1104
        image mini_lair
    if map::vault == 1 pos=53,1201
        image mini_vault
    if map::hall == 1 pos=162,1195
        image mini_hall
    if map::gate == 1 pos=183,1256
        image mini_gate
    if map::here == 1 pos=202,1281
        image mini_here
    if map::here == 2 pos=202,1219
        image mini_here
    if map::here == 3 pos=86,1219
        image mini_here
    if map::here == 4 pos=202,1128
        image mini_here

ui mapView
    image overlay_bg pos=440,20
    text mTitle pos=442,97 width=1450 align=center tint=0.95,0.75,0.4,1
    image map_sheet pos=520,200
    if map::lair == 1 pos=907,209
        image map_lair
    if map::vault == 1 pos=538,572
        image map_vault
    if map::hall == 1 pos=947,547
        image map_hall
    if map::gate == 1 pos=1027,777
        image map_gate
    if map::here == 1 pos=1120,895
        image map_here
    if map::here == 2 pos=1120,660
        image map_here
    if map::here == 3 pos=685,660
        image map_here
    if map::here == 4 pos=1120,320
        image map_here
    text jHint pos=1480,97 tint=0.7,0.6,0.45,1

