func doChores
    call fadeOut
    call closeScenes
    call clearChars
    vn::hudShown = 1
    vn::music = 2
    ui::show sChore z=4.5
    call boxOn
    switch chores::done
        call choreStairs
        call choreRoof
        call choreMochi
        call choreRecycle
        call choreShelf
        call choreShelf
    end
    call earn15
    call chore1
    wait nothing 400ms

func satoIn
    select chr1
    image 0 0 0 sato_smile
    call fadeIn
    dlg::who = 4

func choreStairs
    select bg
    image 0 0 0 bg_stairs
    call satoIn
    dlg::line = 101
    call next
    call clearChars
    sound sfx_sweep 0.7
    dlg::who = 0
    dlg::line = 102
    call next
    select chr1
    image 0 0 0 sato_smile
    call popIn1
    dlg::who = 4
    dlg::line = 103
    call next
    dlg::who = 1
    dlg::line = 104
    call next

func choreRoof
    select bg
    image 0 0 0 bg_rooftop
    call satoIn
    dlg::line = 201
    call next
    call clearChars
    sound sfx_water 0.7
    dlg::who = 1
    dlg::line = 202
    call next
    dlg::who = 0
    dlg::line = 203
    call next

func choreMochi
    select bg
    image 0 0 0 bg_building_day
    select chr2
    image 0 0 0 mochi
    call satoIn
    sound sfx_bark 0.6
    dlg::line = 301
    call next
    call fadeOut
    call clearChars
    select bg
    image 0 0 0 bg_park
    select chr2
    image 0 0 0 mochi
    switch luna::met
        call mochiAlone
        call mochiLuna
    end

func mochiAlone
    call fadeIn
    dlg::who = 0
    dlg::line = 302
    call next

func mochiLuna
    call fadeIn
    dlg::who = 0
    dlg::line = 311
    call next
    select chr1
    image 0 0 0 luna_surprised
    call popIn1
    sound sfx_bark 0.6
    dlg::who = 2
    dlg::line = 312
    call next
    dlg::who = 1
    dlg::line = 313
    call next
    dlg::who = 2
    select chr1
    image 0 0 0 luna_laugh
    dlg::line = 314
    luna::park = 1
    call gainLove
    call next
    dlg::who = 0
    dlg::line = 315
    call next

func choreRecycle
    select bg
    image 0 0 0 bg_building_day
    select chr1
    image 0 0 0 sato_neutral
    call fadeIn
    dlg::who = 4
    dlg::line = 401
    call next
    call clearChars
    sound sfx_thud 0.5
    dlg::who = 0
    dlg::line = 402
    call next
    select chr1
    image 0 0 0 sato_smile
    call popIn1
    dlg::who = 4
    dlg::line = 403
    call next

func choreShelf
    select bg
    image 0 0 0 bg_sato_room
    select chr1
    image 0 0 0 sato_neutral
    call fadeIn
    dlg::who = 4
    dlg::line = 501
    call next
    sound sfx_thud 0.6
    dlg::who = 1
    dlg::line = 502
    call next
    select chr1
    image 0 0 0 sato_smile
    dlg::who = 0
    dlg::line = 503
    call next
