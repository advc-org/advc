// The title screen and starting a new week.

str bNewGame
    en "New Game"
str titleHint
    en "Press ESC at any time to save, load or quit"

ui titleUi modal=false
    if vn::title == 1
        image logo pos=410,150
        image pos=750,600 hit=rect click=clickStart
            source
                switch vn::tbtn
                    1
                        btn_plate_on
                    _
                        btn_plate
            when
                mouse_enter
                    vn::tbtn = 1
                mouse_leave
                    vn::tbtn = 0
        text bNewGame pos=750,618 width=420 align=center size=40 outline=0 tint=0.956,0.855,0.716,1
        text titleHint pos=510,746 width=900 align=center size=28 font=nunito_semibold outline=0.0194,0.0103,0.00802,2 tint=0.871,0.761,0.644,1

func showTitle
    call closeScenes
    call clearChars
    call boxOff
    vn::hudShown = 0
    vn::plan = 0
    vn::ending = 0
    vn::auto = 0
    select bg
    image 0 0 0 bg_title
    vn::title = 1
    vn::tbtn = 0
    vn::music = 1
    call fadeIn

func clickStart
    mouse::active false
    start newGame

func newGame
    call fadeOut
    vn::title = 0
    call resetGame
    start runDay
