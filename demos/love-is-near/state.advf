func sub4Units
    switch money::units
        money::units = 0
        money::units = 0
        money::units = 0
        money::units = 0
        money::units = 0
        money::units = 1
        money::units = 2
        money::units = 3
        money::units = 4
        money::units = 5
        money::units = 6
        money::units = 7
        money::units = 8
        money::units = 9
        money::units = 10
        money::units = 11
        money::units = 12
        money::units = 13
        money::units = 14
        money::units = 15
    end

// --- affection, study, visits, days ------------------------------------------------
func love1
    switch luna::love
        luna::love = 1
        luna::love = 2
        luna::love = 3
        luna::love = 4
        luna::love = 5
        luna::love = 5
    end

func study1
    switch study::pts
        study::pts = 1
        study::pts = 2
        study::pts = 3
        study::pts = 3
    end

func visit1
    switch luna::visit
        luna::visit = 1
        luna::visit = 2
        luna::visit = 3
        luna::visit = 4
        luna::visit = 5
        luna::visit = 5
    end

func chore1
    switch chores::done
        chores::done = 1
        chores::done = 2
        chores::done = 3
        chores::done = 4
        chores::done = 5
        chores::done = 5
    end

func nextDay
    switch day::n
        day::n = 1
        day::n = 2
        day::n = 3
        day::n = 4
        day::n = 5
        day::n = 6
        day::n = 6
    end
