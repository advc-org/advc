// The lecture hall with Daichi, after a glimpse of the campus.
func campusOpen
    call fadeOut
    call closeScenes
    call clearChars
    select bg
    image 0 0 0 bg_campus
    vn::hudShown = 1
    vn::music = 3
    ui::show sCol z=4.5
    call boxOn
    dlg::who = 0

func toLecture
    call fadeOut
    select bg
    image 0 0 0 bg_lecture
    select chr1
    image 0 0 0 daichi_grin
    sound sfx_school 0.5
    call fadeIn

func college1
    call campusOpen
    dlg::line = 101
    call fadeIn
    call next
    select bg
    image 0 0 0 bg_lecture
    sound sfx_school 0.5
    dlg::line = 102
    call next
    select chr1
    image 0 0 0 daichi_grin
    call popIn1
    dlg::who = 3
    dlg::line = 103
    call next
    dlg::who = 1
    dlg::line = 104
    call next
    dlg::who = 3
    dlg::line = 105
    call next
    dlg::who = 1
    dlg::line = 106
    call next
    dlg::who = 3
    dlg::line = 107
    call next
    dlg::who = 6
    select chr1
    image 0 0 0 daichi_worried
    dlg::line = 108
    call next
    dlg::who = 3
    dlg::line = 109
    call next

func college2
    call campusOpen
    call toLecture
    dlg::who = 0
    dlg::line = 201
    call next
    dlg::who = 3
    dlg::line = 202
    call next
    dlg::line = 203
    call next
    dlg::who = 1
    dlg::line = 204
    call next
    dlg::who = 3
    dlg::line = 205
    call next
    dlg::who = 6
    select chr1
    image 0 0 0 daichi_neutral
    dlg::line = 206
    call next

func college3
    call campusOpen
    call toLecture
    dlg::who = 0
    dlg::line = 301
    call next
    dlg::who = 3
    select chr1
    image 0 0 0 daichi_neutral
    dlg::line = 302
    call next
    select chr1
    image 0 0 0 daichi_worried
    dlg::line = 303
    call next
    dlg::who = 1
    dlg::line = 304
    call next
    dlg::who = 3
    select chr1
    image 0 0 0 daichi_grin
    dlg::line = 305
    call next

func college4
    call campusOpen
    dlg::line = 401
    call fadeIn
    call next
    select chr1
    image 0 0 0 daichi_grin
    call popIn1
    dlg::who = 3
    dlg::line = 402
    call next
    dlg::line = 403
    call next
    dlg::who = 1
    dlg::line = 404
    call next
    dlg::who = 3
    dlg::line = 405
    call next

// The quiz: 2 or more study passes.
func college5
    call campusOpen
    call toLecture
    select chr1
    noimage 0
    dlg::who = 0
    dlg::line = 501
    call next
    switch study::pts
        call quizFail
        call quizFail
        call quizPass
        call quizPass
    end

func quizPass
    dlg::line = 511
    quiz::passed = 1
    vn::toast = 7
    sound sfx_pass 0.6
    start showToast
    call next
    select chr1
    image 0 0 0 daichi_worried
    call popIn1
    dlg::who = 3
    dlg::line = 512
    call next

func quizFail
    dlg::line = 521
    vn::toast = 8
    sound sfx_fail 0.6
    start showToast
    call next
    select chr1
    image 0 0 0 daichi_worried
    call popIn1
    dlg::who = 3
    dlg::line = 522
    call next
