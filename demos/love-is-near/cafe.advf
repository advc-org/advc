// --- entering ---------------------------------------------------------------------------------
// The cafe by day in the afternoon, lamplit in the evening (visit 4 is always
// the rainy evening). Every visit pays for its coffee.
func cafeVisit
    call fadeOut
    call closeScenes
    call clearChars
    select bg
    switch day::slot
        image 0 0 0 bg_cafe_day
        image 0 0 0 bg_cafe_day
        image 0 0 0 bg_cafe_eve
        image 0 0 0 bg_cafe_eve
    end
    vn::hudShown = 1
    vn::music = 4
    ui::show sCafe z=4.5
    call boxOn
    dlg::who = 0
    switch luna::visit
        call visitA
        call visitB
        call visitC
        call visitD
        call visitE
        call visitAfter
    end

func lunaIn
    select chr1
    image 0 0 0 luna_smile
    call fadeIn
    sound sfx_bell 0.5
    call spend5

// --- visit 1 ---------------------------------------------------------------------------------
func visitA
    call fadeIn
    sound sfx_bell 0.5
    call spend5
    dlg::line = 101
    call next
    select chr1
    image 0 0 0 luna_smile
    call popIn1
    dlg::who = 7
    dlg::line = 102
    call next
    dlg::who = 0
    dlg::line = 103
    call next
    dlg::opts = 3
    dlg::i1 = 1
    dlg::i2 = 2
    dlg::i3 = 4
    dlg::menu = 1
    call choose
    dlg::who = 2
    switch dlg::pick
        dlg::pick = 0
        call v1Black
        call v1Recommend
        call v1Often
    end
    select chr1
    image 0 0 0 luna_smile
    dlg::who = 2
    dlg::line = 141
    call next
    dlg::who = 1
    dlg::line = 142
    call next
    dlg::who = 2
    select chr1
    image 0 0 0 luna_laugh
    dlg::line = 143
    call next
    luna::met = 1
    call visit1

func v1Black
    select chr1
    image 0 0 0 luna_neutral
    dlg::line = 111
    call next
func v1Recommend
    select chr1
    image 0 0 0 luna_laugh
    dlg::line = 121
    call next
    dlg::who = 1
    dlg::line = 122
    call next
    dlg::who = 2
    select chr1
    image 0 0 0 luna_blush
    dlg::line = 123
    call gainLove
    call next
func v1Often
    select chr1
    image 0 0 0 luna_surprised
    dlg::line = 131
    call next
    dlg::who = 1
    dlg::line = 132
    call next

// --- visit 2 ---------------------------------------------------------------------------------
func visitB
    call lunaIn
    dlg::who = 2
    dlg::line = 201
    call next
    dlg::who = 1
    dlg::line = 202
    call next
    dlg::who = 2
    select chr1
    image 0 0 0 luna_neutral
    dlg::line = 203
    call next
    dlg::opts = 3
    dlg::i1 = 1
    dlg::i2 = 3
    dlg::i3 = 4
    dlg::menu = 2
    call choose
    switch dlg::pick
        dlg::pick = 0
        call v2Food
        call v2Stars
        call v2Home
    end
    dlg::who = 0
    select chr1
    image 0 0 0 luna_smile
    dlg::line = 241
    call next
    call visit1

func v2Food
    select chr1
    image 0 0 0 luna_smile
    dlg::line = 211
    call next
func v2Stars
    select chr1
    image 0 0 0 luna_surprised
    dlg::line = 221
    call next
    select chr1
    image 0 0 0 luna_laugh
    dlg::line = 222
    call next
    dlg::who = 1
    dlg::line = 223
    call next
    dlg::who = 2
    select chr1
    image 0 0 0 luna_blush
    dlg::line = 224
    call gainLove
    call next
func v2Home
    select chr1
    image 0 0 0 luna_sad
    dlg::line = 231
    call next
    select chr1
    image 0 0 0 luna_smile
    dlg::line = 232
    call next

// --- visit 3 ---------------------------------------------------------------------------------
func visitC
    select chr1
    image 0 0 0 luna_neutral
    call fadeIn
    sound sfx_bell 0.5
    call spend5
    dlg::who = 0
    dlg::line = 301
    call next
    dlg::who = 2
    select chr1
    image 0 0 0 luna_surprised
    dlg::line = 302
    call next
    dlg::opts = 3
    dlg::i1 = 1
    dlg::i2 = 4
    dlg::i3 = 3
    dlg::menu = 3
    call choose
    switch dlg::pick
        dlg::pick = 0
        call v3Ask
        call v3Grab
        call v3Work
    end
    call visit1

func v3Ask
    select chr1
    image 0 0 0 luna_smile
    dlg::line = 311
    call next
    select chr1
    image 0 0 0 luna_blush
    dlg::line = 312
    call next
    dlg::who = 0
    dlg::line = 313
    call next
    dlg::who = 1
    dlg::line = 314
    call gainLove
    call next
func v3Grab
    select chr1
    image 0 0 0 luna_sad
    dlg::line = 321
    call next
    dlg::who = 0
    dlg::line = 322
    call next
    dlg::who = 1
    dlg::line = 323
    call next
func v3Work
    select chr1
    image 0 0 0 luna_neutral
    dlg::line = 331
    call next
    select chr1
    image 0 0 0 luna_sad
    dlg::line = 332
    call next

// --- visit 4: the rainy evening ------------------------------------------------------------
func visitD
    select bg
    image 0 0 0 bg_cafe_rain
    select chr1
    image 0 0 0 luna_smile
    call fadeIn
    sound sfx_rain 0.5
    sound sfx_bell 0.4
    call spend5
    dlg::who = 0
    dlg::line = 401
    call next
    dlg::who = 2
    dlg::line = 402
    call next
    select chr1
    image 0 0 0 luna_neutral
    dlg::line = 403
    call next
    select chr1
    image 0 0 0 luna_sad
    dlg::line = 404
    call next
    dlg::opts = 3
    dlg::i1 = 2
    dlg::i2 = 4
    dlg::i3 = 5
    dlg::menu = 4
    call choose
    switch dlg::pick
        dlg::pick = 0
        call v4Book
        call v4Babies
        call v4Refill
    end
    dlg::who = 0
    dlg::line = 441
    call next
    call visit1

func v4Book
    select chr1
    image 0 0 0 luna_blush
    dlg::line = 411
    call next
    dlg::who = 1
    dlg::line = 412
    call next
    dlg::who = 2
    select chr1
    image 0 0 0 luna_laugh
    dlg::line = 413
    call gainLove
    call next
func v4Babies
    select chr1
    image 0 0 0 luna_sad
    dlg::line = 421
    call next
func v4Refill
    select chr1
    image 0 0 0 luna_neutral
    dlg::line = 431
    call next

// --- visit 5: the ask ------------------------------------------------------------------------
func visitE
    call lunaIn
    dlg::who = 2
    dlg::line = 501
    call next
    dlg::who = 1
    dlg::line = 502
    call next
    dlg::opts = 2
    dlg::i1 = 2
    dlg::i2 = 1
    dlg::menu = 5
    call choose
    switch dlg::pick
        dlg::pick = 0
        call askHer
        call askRunAway
    end

// Asking counts as the fifth visit; running away does not (ask next time).
func askHer
    luna::asked = 1
    call visit1
    switch luna::love
        call askNo
        call askNo
        call askNo
        call askYes
        call askYes
        call askYes
    end

func askNo
    dlg::who = 2
    select chr1
    image 0 0 0 luna_sad
    dlg::line = 511
    call next
    dlg::line = 512
    call next
    dlg::who = 0
    dlg::line = 513
    call next

func askYes
    dlg::who = 2
    select chr1
    image 0 0 0 luna_surprised
    dlg::line = 521
    call next
    select chr1
    image 0 0 0 luna_blush
    dlg::line = 522
    call next
    switch money::units
        call askBroke
        call askBroke
        call askBroke
        call askBroke
        call askPaid
        call askPaid
        call askPaid
        call askPaid
        call askPaid
        call askPaid
        call askPaid
        call askPaid
        call askPaid
        call askPaid
        call askPaid
        call askPaid
        call askPaid
        call askPaid
        call askPaid
        call askPaid
    end

func askPaid
    dlg::who = 1
    dlg::line = 531
    call spend20
    luna::date = 1
    call next
    dlg::who = 2
    select chr1
    image 0 0 0 luna_laugh
    dlg::line = 532
    call next

func askBroke
    dlg::who = 0
    dlg::line = 541
    call next
    dlg::who = 1
    dlg::line = 542
    call next
    dlg::who = 2
    select chr1
    image 0 0 0 luna_smile
    dlg::line = 543
    call next
    dlg::who = 0
    select prop
    image 0 0 0 cup
    call popInProp
    dlg::line = 544
    call next
    dlg::who = 2
    select chr1
    image 0 0 0 luna_blush
    dlg::line = 545
    luna::number = 1
    call next

func askRunAway
    dlg::who = 2
    select chr1
    image 0 0 0 luna_surprised
    dlg::line = 551
    call next
    dlg::who = 0
    call clearChars
    dlg::line = 552
    call next

// --- after the fifth visit ----------------------------------------------------------------------
func visitAfter
    call lunaIn
    dlg::who = 2
    switch luna::date
        call afterNoDate
        call afterDate
    end

func afterDate
    dlg::line = 601
    call next
func afterNoDate
    switch luna::number
        call afterRegular
        call afterNumber
    end
func afterNumber
    dlg::line = 602
    call next
func afterRegular
    select chr1
    image 0 0 0 luna_neutral
    dlg::line = 603
    call next
